# ── ScuolaBoard .gitignore ────────────────────────────────────────────────
# Esclude file locali/IDE/segreti/artefatti generati.
# La build di produzione va in docs/ (GitHub Pages), NON in dist/.

# ── Dependencies (rigenerate via npm install) ──
node_modules/

# ── Logs ──
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ── OS metadata ──
.DS_Store            # macOS Finder
Thumbs.db            # Windows thumbnail cache
desktop.ini          # Windows folder config

# ── IDE / editor ──
.vscode/             # VSCode workspace settings (user-specific)
.idea/               # JetBrains
*.swp                # Vim swap
*.swo
*~                   # Backup files di vari editor
*.bak

# ── Secrets (mai committare) ──
.env
.env.local
.env.*.local
*.pem
*.key
service-account.json

# ── Temp / patch artifacts ──
*.tmp
*.orig
*.rej

# ── Build artifacts ──
# La build di produzione va in docs/ (GitHub Pages: Settings → Pages → folder
# /docs), NON in dist/. `docs/` è INTENZIONALMENTE committato (vedi fondo file).

# ── Firebase Admin SDK (migrations/) ──
# migrations/.gitignore gia gestisce service-account.json.
# Escludo anche eventuali dump/export locali:
migrations/exports/
migrations/*.csv


# ── Firebase SDK logs (sviluppo locale) ──
firebase-debug.log
firestore-debug.log
ui-debug.log
firebase-functions-debug.log
*.firebase.log

# ── Firebase CLI cache ──
.firebase/
.firebasehosting.cache

# Vite build output (dist/ generato da `vite build` locale — NON committato)
dist/

# Coverage vitest (artefatti generati)
coverage/

# Playwright
/test-results/
/playwright-report/
/playwright/.cache/

# docs/ INTENZIONALMENTE committato per GitHub Pages

# Backup locale del codice (non committare)
backup/
